# Spicyhub B2B SaaS Security & Platform Environment (Template)
PORT=3000
NODE_ENV=production

# Cryptographic Session & Signing Secret (Generate using crypto.randomBytes(32).toString('hex'))
SESSION_SECRET=your_secure_64_character_hex_secret_here

# SaaS Superadmin Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://spicyhub.com,https://app.spicyhub.com

# Authentication & Brute Force Protection
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# Automated Database Backup & Retention
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=7
